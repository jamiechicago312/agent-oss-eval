{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oss-eval.dev/schema/report.schema.json",
  "title": "oss-eval report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "target",
    "generated_at",
    "window",
    "repository",
    "metrics",
    "signals",
    "comparison",
    "provenance",
    "limitations",
    "completeness"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "full_name", "url"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "full_name": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "days"],
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "end": { "type": "string", "minLength": 1 },
        "days": { "type": "integer", "minimum": 1 }
      }
    },
    "repository": { "type": "object" },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    },
    "signals": { "type": "array" },
    "comparison": { "type": ["object", "null"] },
    "provenance": { "type": "object" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "completeness": {
      "enum": ["complete", "partial", "failed"]
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "definition", "sample_size", "source", "window", "confidence"],
      "properties": {
        "value": {},
        "unit": { "type": "string" },
        "definition": { "type": "string", "minLength": 1 },
        "sample_size": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "window": { "type": "string", "minLength": 1 },
        "confidence": {
          "enum": ["measured", "inferred", "cached", "partial", "unavailable"]
        }
      }
    }
  }
}
